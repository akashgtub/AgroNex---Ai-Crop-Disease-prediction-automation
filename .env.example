# ==========================================
# AgroNex Environment Variables Example
# ==========================================

# --- Frontend (Vite) ---
# Used by React to connect to the FastAPI backend.
VITE_API_URL=http://localhost:8000
# In production on Render, set this to your Render backend URL:
# VITE_API_URL=https://agronex-backend-xxxxx.onrender.com

# --- Backend (FastAPI) ---
# Used by FastAPI to allow CORS requests from the frontend.
FRONTEND_URL=http://localhost:5173
# In production on Render, set this to your Render frontend URL:
# FRONTEND_URL=https://agronex-frontend-xxxxx.onrender.com

# Alternatively, allow all origins during initial testing:
ALLOW_ALL_ORIGINS=false
